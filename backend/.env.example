# ─── Backend Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in the values below
# cp .env.example .env

# MongoDB Atlas connection string
# How to get it:
#   1. Go to cloud.mongodb.com
#   2. Click "Connect" on your cluster
#   3. Select "Drivers" → Node.js
#   4. Copy the connection string and replace <password> with your DB user password
#   Example (SRV format):      mongodb+srv://username:password@cluster.mongodb.net/feedants
#   Example (direct format):   mongodb://username:password@host1:27017,host2:27017/feedants?ssl=true&authSource=admin
MONGO_URI=

# Secret key used to sign JWT tokens — can be any random string
# Example: feedants_super_secret_jwt_key_2026
JWT_SECRET=

# Port the Express server listens on (default: 5000)
PORT=5000
