# ─── Mobile Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in the values below
# cp .env.example .env

# Base URL of the backend API
# IMPORTANT: Use your machine's LAN IP address, NOT "localhost"
#   - "localhost" only works on the PC itself, not on your phone
#   - Find your LAN IP on Windows:
#       Run in PowerShell: (Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.IPAddress -like "192.*" }).IPAddress
#   - Find your LAN IP on Mac/Linux:
#       Run in terminal: ipconfig getifaddr en0
#   Example: http://192.168.1.66:5000
EXPO_PUBLIC_API_URL=http://<YOUR_LAN_IP>:5000

# MongoDB competition ID to display on the details screen
# How to get it:
#   Run: cd backend && node scripts/seed.js
#   Copy the "Competition ID:" printed at the end
#   Example: 6ab9cb2b1d00bdc7230024fc
EXPO_PUBLIC_COMPETITION_ID=<COMPETITION_ID_FROM_SEED_SCRIPT>
